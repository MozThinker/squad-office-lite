# Squad Office Lite, modo Docker: variáveis opcionais do compose.yaml.
# Para mudar alguma, copia este ficheiro para «.env» na mesma pasta do compose.yaml e tira o # da linha.
# Sem .env valem as omissões indicadas. Depois de mudar: docker compose up -d

# Endereço onde o Office fica à escuta. 127.0.0.1 = só este PC. 0.0.0.0 = também outros aparelhos da rede local
# (ex.: o telemóvel), em HTTP sem cifra: só numa rede em que confias.
# OFFICE_ENDERECO=127.0.0.1

# Porta do Office no PC (http://localhost:8080). Muda-a se a 8080 já estiver ocupada.
# OFFICE_PORTA=8080

# Pasta dos projectos (repositórios git) que a squad pode alterar, relativa a esta pasta ou absoluta.
# No Windows usa barras para a frente, ex.: C:/Users/<nome>/office/projectos
# OFFICE_PROJECTOS=./projectos

# Utilizador e grupo dos contentores office e runner. No Windows e no macOS deixa a omissão. Em Linux sem Docker
# Desktop, usa os teus (id -u e id -g) para os ficheiros dos projectos ficarem teus.
# OFFICE_UID=10001
# OFFICE_GID=10001
