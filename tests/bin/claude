#!/usr/bin/env python3
"""`claude` falso e determinístico (testes e teste de fumo): nunca chama a rede.

Lê o stdin todo; FAKE_CLAUDE_ARGV=<ficheiro> anexa json.dumps(argv); FAKE_CLAUDE_STDIN=<ficheiro> grava o stdin.
Escreve em stream-json um init e um result; com --resume <id> reutiliza essa sessão.
FAKE_CLAUDE_FALHA=1 → is_error true e exit 1.
FAKE_CLAUDE_EXIGE_CRED=1 → falha (como FAKE_CLAUDE_FALHA) sem ANTHROPIC_API_KEY nem CLAUDE_CODE_OAUTH_TOKEN no env.
FAKE_CLAUDE_CRED=<ficheiro> anexa {variável: sha256 do valor} das credenciais presentes (nunca o valor).
FAKE_CLAUDE_SETTINGS=<ficheiro> anexa {"texto", "modo", "uid"} do ficheiro de --settings (o runner apaga-o no fim).
Com --output-format json (rascunhos e ensaios dos agentes) escreve um só objecto result: "result" = conteúdo de
FAKE_CLAUDE_RESULTADO (ficheiro) se existir, "total_cost_usd" = FAKE_CLAUDE_CUSTO ou 0.01.
FAKE_CLAUDE_RESULTADOS=<pasta> consome 1.txt, 2.txt, … por ordem (um por chamada; renomeia para .usado) e ganha a
FAKE_CLAUDE_RESULTADO (conversa de várias voltas). Ambos valem também em stream-json (o "result" final).
FAKE_CLAUDE_DORME=<s> dorme antes de responder (timeouts). FAKE_CLAUDE_CWD=<ficheiro> anexa {"cwd", "agentes",
"skills", "remotes"} da pasta onde corre (.claude/agents e .claude/skills, `git remote`).
"""
import hashlib
import json
import os
import subprocess
import sys
import time
import uuid

argv = sys.argv[1:]
entrada = sys.stdin.read()
if os.environ.get("FAKE_CLAUDE_ARGV"):
    with open(os.environ["FAKE_CLAUDE_ARGV"], "a", encoding="utf-8") as f:
        f.write(json.dumps(argv) + "\n")
if os.environ.get("FAKE_CLAUDE_STDIN"):
    with open(os.environ["FAKE_CLAUDE_STDIN"], "w", encoding="utf-8") as f:
        f.write(entrada)
if os.environ.get("FAKE_CLAUDE_SETTINGS") and "--settings" in argv[:-1]:
    st = os.stat(argv[argv.index("--settings") + 1])
    with open(argv[argv.index("--settings") + 1], encoding="utf-8") as f:
        copia = {"texto": f.read(), "modo": st.st_mode & 0o777, "uid": st.st_uid}
    with open(os.environ["FAKE_CLAUDE_SETTINGS"], "a", encoding="utf-8") as f:
        f.write(json.dumps(copia) + "\n")
CRED = ("ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN")
if os.environ.get("FAKE_CLAUDE_CRED"):
    with open(os.environ["FAKE_CLAUDE_CRED"], "a", encoding="utf-8") as f:
        f.write(json.dumps({k: hashlib.sha256(os.environ[k].encode()).hexdigest() for k in CRED if k in os.environ})
                + "\n")
if os.environ.get("FAKE_CLAUDE_CWD"):
    def _lista(p):
        return sorted(os.listdir(p)) if os.path.isdir(p) else None
    r = subprocess.run(["git", "remote"], capture_output=True, text=True, check=False)
    with open(os.environ["FAKE_CLAUDE_CWD"], "a", encoding="utf-8") as f:
        f.write(json.dumps({"cwd": os.getcwd(), "agentes": _lista(".claude/agents"), "skills": _lista(".claude/skills"),
                            "remotes": r.stdout.split() if r.returncode == 0 else None}) + "\n")
if os.environ.get("FAKE_CLAUDE_DORME"):
    time.sleep(float(os.environ["FAKE_CLAUDE_DORME"]))
sid = argv[argv.index("--resume") + 1] if "--resume" in argv[:-1] else str(uuid.uuid4())
falha = os.environ.get("FAKE_CLAUDE_FALHA") == "1" or (
    os.environ.get("FAKE_CLAUDE_EXIGE_CRED") == "1" and not any(os.environ.get(k) for k in CRED))
compacto = {"separators": (",", ":")}


def _resultado():
    pasta = os.environ.get("FAKE_CLAUDE_RESULTADOS")
    if pasta and os.path.isdir(pasta):
        nums = sorted(int(n[:-4]) for n in os.listdir(pasta) if n.endswith(".txt") and n[:-4].isdigit())
        if nums:
            caminho = os.path.join(pasta, f"{nums[0]}.txt")
            with open(caminho, encoding="utf-8") as f:
                texto = f.read()
            os.replace(caminho, caminho[:-4] + ".usado")
            return texto
    if os.environ.get("FAKE_CLAUDE_RESULTADO") and os.path.exists(os.environ["FAKE_CLAUDE_RESULTADO"]):
        with open(os.environ["FAKE_CLAUDE_RESULTADO"], encoding="utf-8") as f:
            return f.read()
    return None


if "--output-format" in argv and argv[argv.index("--output-format") + 1:][:1] == ["json"]:
    resultado = "falhou" if falha else "ok"
    if (texto := _resultado()) is not None:
        resultado = texto
    print(json.dumps({"type": "result", "subtype": "error_during_execution" if falha else "success", "is_error": falha,
                      "total_cost_usd": float(os.environ.get("FAKE_CLAUDE_CUSTO") or 0.01), "num_turns": 1,
                      "duration_ms": 1000, "session_id": sid, "result": resultado}, **compacto), flush=True)
    sys.exit(1 if falha else 0)
print(json.dumps({"type": "system", "subtype": "init", "session_id": sid}, **compacto), flush=True)
final = "falhou" if falha else "ok"
if not falha and (texto := _resultado()) is not None:
    final = texto
print(json.dumps({"type": "result", "subtype": "error_during_execution" if falha else "success", "is_error": falha,
                  "total_cost_usd": 0.01, "num_turns": 1, "duration_ms": 1000, "session_id": sid,
                  "result": final}, **compacto), flush=True)
sys.exit(1 if falha else 0)
